# SPPS Version 1.0 - Free — local developer settings (automated tests and developer tools only).
# To run the real app against Supabase use .env.local (see START-HERE.md).
DATABASE_URL=sqlite:///./data/model_c.db
MODEL_C_INIT_DB=true
MODEL_C_COOKIE_SECURE=false
MODEL_C_PUBLIC_TENANT=model-c-demo
MODEL_C_PAYMENT_TEST_MODE=true
MODEL_C_ALLOW_TEST_ERASURE=true
MODEL_C_WEBRTC_ENABLED=true
# Consultation commission is fixed at 3000 bps (30% platform; 70% practitioner)
MODEL_C_ROUTE_AUTO_TRANSFER=false
# PRODUCTION PAYMENT PROVIDER — intentionally not configured
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Never deploy a test profile, demo credentials or a public database connection.

# LOCAL-ONLY registration simulation; NEVER enable in production
MODEL_C_ENV=local
MODEL_C_ALLOW_TEST_SUBSCRIPTION_ACTIVATION=true
# RAZORPAY_PLAN_CORE_ID=plan_...   # ₹199/month in Razorpay dashboard
# RAZORPAY_PLAN_PRO_ID=plan_...    # ₹499/month in Razorpay dashboard
# Registration and consultation payments require Razorpay key + secret + webhook secret.
# v2 (local): the bot check uses a per-process secret locally; set SPPS_BOT_MIN_FILL_SECONDS=0 only in tests.
SPPS_BOT_MIN_FILL_SECONDS=3
SPPS_AI_FEATURES_ENABLED=false
SPPS_ATHLETE_LOOP_ENABLED=false
SPPS_DIRECTORY_ENABLED=false
# Crisis contacts shown on the public directory and in enquiry auto-replies. Confirm the numbers before use.
SPPS_CRISIS_CONTACTS_TEXT="Emergency: 112 · Tele-MANAS mental health helpline: 14416 (free, 24x7)"
SPPS_SELF_SERVE_ENABLED=false
SPPS_REPORT_LINKS_ENABLED=false
SPPS_PRACTITIONER_CLOSURE_ENABLED=false
# Booking-only directory phase 2: appointment requests from a directory card (needs portal + directory + SQL 44_0043).
SPPS_DIRECTORY_BOOKING_ENABLED=false
# Phase 4 notifications (SQL 47_0046 first). Generate keys once with: python tools/generate_vapid_keys.py
SPPS_PUSH_ENABLED=false
SPPS_NOTIFY_WORKER_ENABLED=false
SPPS_VAPID_PUBLIC_KEY=<public key from generate_vapid_keys.py>
SPPS_VAPID_PRIVATE_KEY=<private key from generate_vapid_keys.py; secret>
SPPS_VAPID_SUBJECT=mailto:<a monitored contact address>
SPPS_REMINDER_MINUTES=60
SPPS_NOTIFY_INTERVAL_SECONDS=30
# Optional, Android app push (Firebase service-account JSON as one line; secret):
# SPPS_FCM_SERVICE_ACCOUNT_JSON=

# Phase 3 video: configure a TURN relay before enabling real online appointments.
# Placeholders only; set the real relay URL and shared secret outside this repository.
MODEL_C_ICE_URLS=turns:turn.example.org:443?transport=tcp
MODEL_C_TURN_SECRET=<at-least-32-character-shared-secret>
