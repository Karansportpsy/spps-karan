# Keep every text file LF in the repository and in working trees, on every OS.
# Migration checksums (server/release_migrations.py) and the byte-identical www/ copy depend on it.
* text=auto eol=lf

# Binary assets: never normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.ttf binary
*.woff binary
*.woff2 binary
