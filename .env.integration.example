# SPPS M1.2 FICTITIOUS local integration configuration REFERENCE ONLY.
# DO NOT copy this file over the generated .env.integration.
# Provision a NEW empty local spps_dev* PostgreSQL database using tools/development_db.py;
# the provisioner writes actual random test passwords and split DB roles into an ignored .env.integration.
# Never use a hosted PostgreSQL URL in this profile.
MODEL_C_ENV=local
MODEL_C_INTEGRATION_DEV=true
SPPS_DEV_CLINICAL_PARITY=true
MODEL_C_INIT_DB=false
MODEL_C_SEED_DEMO=false
MODEL_C_COOKIE_SECURE=false
MODEL_C_PAYMENT_TEST_MODE=false
MODEL_C_ALLOW_TEST_ERASURE=false
MODEL_C_ALLOW_TEST_SUBSCRIPTION_ACTIVATION=false
MODEL_C_HOSTED_PILOT_UNLOCKED=false
MODEL_C_ROUTE_AUTO_TRANSFER=false
MODEL_C_WEBRTC_ENABLED=false
MODEL_C_PUBLIC_TENANT=model-c-demo
# The following are written by the provisioner; illustrative placeholders ONLY.
DATABASE_URL=postgresql+psycopg://LOCAL_APP_ROLE:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/spps_dev_REPLACE
SPPS_AUTH_DATABASE_URL=postgresql+psycopg://LOCAL_AUTH_ROLE:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/spps_dev_REPLACE
# Provision-only: do not pass to a running server or hosted environment:
# SPPS_DEV_ADMIN_URL=postgresql+psycopg://LOCAL_ADMIN:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/spps_dev_REPLACE
# Generated fixture passwords (never commit values):
# SPPS_DEV_ALICE_PASSWORD=
# SPPS_DEV_BOB_PASSWORD=
# SPPS_ANDROID_DEV_URL=http://localhost:8000/studio  # debug build only; ADB reverse maps to Windows 8001
