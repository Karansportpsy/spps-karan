# SPPS Version 1.0 - Free — production settings (Render). Copy the same values into .env.local to run the app on
# your own computer against the same Supabase database (see START-HERE.md).
# Values marked <secret> live only in the Render environment, never in Git.
MODEL_C_ENV=production
SPPS_PRODUCTION_RELEASE_APPROVED=true        # set by the owner only
SPPS_HOSTED_RLS=true
SPPS_SINGLE_DATABASE_SCHEMAS=true
SPPS_SUPABASE_PROJECT_REF=<supabase project ref>
SPPS_CLINICAL_DATABASE_NAME=postgres
SPPS_IDENTITY_DATABASE_NAME=postgres
MODEL_C_PUBLIC_TENANT=winmindperform
SPPS_BETA_V1_FREE=true
SPPS_PAYMENT_PROVIDER=disabled
SPPS_PORTAL_ENABLED=false                    # athlete/guardian accounts; needs the SMTP settings below
SPPS_SUPABASE_AUTH_ENABLED=true
SPPS_SUPABASE_URL=https://<supabase project ref>.supabase.co
SPPS_SUPABASE_PUBLISHABLE_KEY=<publishable key>
SPPS_OWNER_EMAIL=<owner email>
SPPS_OWNER_BOOTSTRAP_ENABLED=true
SPPS_PUBLIC_BASE_URL=https://app.winmindperform.com
MODEL_C_ALLOWED_HOSTS=app.winmindperform.com,<your-service>.onrender.com
MODEL_C_COOKIE_SECURE=true
MODEL_C_INIT_DB=false
MODEL_C_SEED_DEMO=false
SPPS_TRUSTED_PROXY_HOPS=1
# Four distinct restricted roles on the Supabase session pooler (port 5432, TLS required).
DATABASE_URL=postgresql+psycopg://spps_dev_app.<ref>:<secret>@<pooler host>:5432/postgres?sslmode=require
SPPS_AUTH_DATABASE_URL=postgresql+psycopg://spps_dev_auth.<ref>:<secret>@<pooler host>:5432/postgres?sslmode=require
SPPS_IDENTITY_AUTH_DATABASE_URL=postgresql+psycopg://spps_identity_auth.<ref>:<secret>@<pooler host>:5432/postgres?sslmode=require
SPPS_IDENTITY_PORTAL_DATABASE_URL=postgresql+psycopg://spps_identity_portal.<ref>:<secret>@<pooler host>:5432/postgres?sslmode=require
# E-mail (SMTP). Optional for practitioners only; required before SPPS_PORTAL_ENABLED / the athlete app.
# Configure all of them or none. SPPS_SMTP_SENDER is the same address as SPPS_SMTP_FROM.
# SPPS_SMTP_HOST=
# SPPS_SMTP_PORT=587
# SPPS_SMTP_USERNAME=
# SPPS_SMTP_PASSWORD=<secret>
# SPPS_SMTP_FROM=
# SPPS_SMTP_SENDER=
# Never set in production: MODEL_C_SEED_DEMO=true, MODEL_C_PAYMENT_TEST_MODE, MODEL_C_ALLOW_TEST_ERASURE,
# MODEL_C_ALLOW_TEST_SUBSCRIPTION_ACTIVATION, MODEL_C_INTEGRATION_DEV. Startup refuses them.
# ---- v2 (spps-v2) -------------------------------------------------------------------------------------------------
# Bot check for public forms (phase 1). Required in hosted mode: 32+ random characters. <secret>
SPPS_FORM_TOKEN_SECRET=<secret>
SPPS_BOT_MIN_FILL_SECONDS=3
# Client-facing feature flags. All default to false; switch on in the order given in DEPLOYMENT.md.
SPPS_AI_FEATURES_ENABLED=false
SPPS_ATHLETE_LOOP_ENABLED=false
SPPS_DIRECTORY_ENABLED=false
# Crisis contacts shown on the public directory and in enquiry auto-replies. Confirm the numbers before launch.
SPPS_CRISIS_CONTACTS_TEXT="Emergency: 112 · Tele-MANAS mental health helpline: 14416 (free, 24x7)"
SPPS_SELF_SERVE_ENABLED=false
SPPS_REPORT_LINKS_ENABLED=false
SPPS_PRACTITIONER_CLOSURE_ENABLED=false
# Booking-only directory phase 2: appointment requests from a directory card (needs portal + directory + SQL 44_0043).
SPPS_DIRECTORY_BOOKING_ENABLED=false
# Field encryption for notes and formulations (phase 2). <secret> Keep every key in a password manager.
SPPS_FIELD_KEYS=k1:<secret base64 32 bytes>
SPPS_FIELD_KEY_CURRENT=k1
SPPS_CLOSURE_NOTICE_DAYS=30
SPPS_CLOSURE_COOLING_OFF_DAYS=14

# Phase 3 video: configure a TURN relay before enabling real online appointments.
# Placeholders only; set the real relay URL and shared secret outside this repository.
MODEL_C_ICE_URLS=turns:turn.example.org:443?transport=tcp
MODEL_C_TURN_SECRET=<at-least-32-character-shared-secret>
